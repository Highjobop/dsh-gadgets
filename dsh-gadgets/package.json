    "dsh-task-alerts": "^0.4.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "theme",
    "skin",
    "conversation",
    "notify",
    "ui"
  ],
  "author": "Highjobop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Highjobop/dsh-gadgets.git"
